# Local listeners stay private; Funnel terminates public HTTPS.
SNAPFLOW_API_PORT=3000
SNAPFLOW_DEV_HOST=127.0.0.1
SNAPFLOW_DEV_PORT=5173
SNAPFLOW_WEBSITE_HOST=127.0.0.1
SNAPFLOW_WEBSITE_PORT=5174
# Run CONFIGURAR_SITE_PUBLICO.bat after connecting Tailscale to discover and write the current hostname.
SNAPFLOW_ALLOWED_HOSTS=
PUBLIC_WEBSITE_URL=https://your-device.tailnet.ts.net
# The helper replaces these placeholders and copies the website URL into backend/.env.local.
# Database values are managed by the existing installer/sync script.
